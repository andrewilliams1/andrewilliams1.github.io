<!doctype html>
{#- Generated by build.py from resume.yaml. Edit resume.yaml, not _site/index.html.
    Styled to match the PDF résumé: Fira Sans, navy section bars, same entry layout. #}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ basics.name }}, {{ basics.label }}</title>
  <meta name="description" content="{{ basics.summary | truncate(155) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet">
  <style>
    /* Colours taken from the résumé's LaTeX template */
    :root {
      --primary: #000000;   /* names, org titles */
      --secondary: #0D47A1; /* section bars */
      --accent: #263238;    /* subtitles, dates */
      --links: #1565C0;
      --ink: #1B2228; --muted: #455A64; --line: #D5DCE3;
      --page: #E9EDF2; --paper: #FFFFFF;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--page); color: var(--ink);
      font: 300 16px/1.55 "Fira Sans", system-ui, sans-serif; }
    a { color: var(--links); }
    a:hover { color: var(--secondary); }
    strong, b { font-weight: 600; }

    .topbar { max-width: 960px; margin: 0 auto; padding: 16px 24px;
      display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; }
    .topbar .domain { font-weight: 500; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--muted); text-decoration: none; }
    .topbar nav { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; }
    .topbar nav a { color: var(--ink); text-decoration: none; font-weight: 400; padding: 12px 12px; border-radius: 6px; }
    .topbar nav a:hover { background: rgba(13,71,161,0.08); }
    .btn, .topbar nav a.btn { background: var(--secondary); color: #fff; padding: 12px 18px; border-radius: 6px;
      font-weight: 500; text-decoration: none; display: inline-block; }
    .btn:hover, .topbar nav a.btn:hover { background: #0A3880; color: #fff; }

    main { max-width: 960px; margin: 0 auto 24px; background: var(--paper); border-radius: 4px;
      box-shadow: 0 1px 2px rgba(16,24,40,0.06), 0 12px 32px rgba(16,24,40,0.08);
      padding: 56px 64px; display: flex; flex-direction: column; gap: 32px; }

    header.head { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
    .who { display: flex; gap: 22px; align-items: center; flex: 999 1 380px; min-width: 0; }
    .who img { width: 104px; height: 104px; flex: 0 0 104px; border-radius: 50%;
      object-fit: cover; object-position: 50% 28%; }
    .who h1 { margin: 0; font-size: 50px; line-height: 1.05; font-weight: 700; color: var(--primary); }
    .who .label { font-style: italic; color: var(--accent); font-size: 18px; padding-top: 6px; }
    .contact { flex: 1 1 240px; display: flex; flex-direction: column; gap: 2px; font-size: 15px; font-weight: 400; }
    .contact a { display: flex; gap: 8px; align-items: center; text-decoration: none; padding: 4px 0; overflow-wrap: anywhere; }
    .contact svg { flex: 0 0 15px; color: var(--accent); }

    .summary { margin: 0; font-size: 17px; color: var(--accent); max-width: 760px; }

    section { display: flex; flex-direction: column; gap: 16px; }
    .bar { align-self: flex-start; margin: 0; background: var(--secondary); color: #fff;
      font-size: 16px; font-weight: 600; padding: 3px 12px; display: flex; gap: 8px; align-items: center; }

    .entry { padding-left: 10px; display: flex; flex-direction: column; gap: 4px; }
    .entry + .entry { margin-top: 10px; }
    .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 16px; }
    .org { font-weight: 600; color: var(--primary); font-size: 17px; }
    .date { color: var(--accent); font-size: 15px; font-weight: 400; }
    .sub { font-style: italic; color: var(--accent); font-size: 15px; }
    .role { margin-top: 8px; }
    ul.items { margin: 4px 0 0; padding-left: 22px; list-style: none; display: flex; flex-direction: column; gap: 4px;
      font-size: 15.5px; color: var(--ink); }
    ul.items li { position: relative; }
    ul.items li::before { content: "›"; position: absolute; left: -16px; color: var(--accent); font-weight: 500; }

    .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; padding-left: 10px; }
    .project { border: 1px solid var(--line); border-radius: 6px; padding: 18px; display: flex; flex-direction: column; gap: 6px; }
    .project h3 { margin: 0; font-size: 17px; font-weight: 600; color: var(--primary); }
    .project h3 a { color: inherit; }
    .project .context { font-style: italic; color: var(--accent); font-size: 14px; }
    .project ul.items { font-size: 15px; }
    .project .tags { margin-top: auto; padding-top: 6px; font-size: 13px; color: var(--muted); font-weight: 400; }

    .skills { padding-left: 10px; display: flex; flex-direction: column; gap: 6px; font-size: 15.5px; }
    .skills b { color: var(--primary); margin-right: 6px; }

    footer.foot { max-width: 960px; margin: 0 auto 48px; padding: 0 24px; display: flex; flex-wrap: wrap;
      gap: 12px 16px; align-items: center; justify-content: space-between; font-size: 14px; color: var(--muted); }

    @media (max-width: 720px) {
      main { padding: 32px 20px; border-radius: 0; }
      .who { flex-direction: column; align-items: flex-start; }
      .who h1 { font-size: 38px; }
      .entry, .projects, .skills { padding-left: 0; }
    }
    @media print {
      .topbar, footer.foot { display: none; }
      body { background: #fff; }
      main { box-shadow: none; padding: 0; }
    }
  </style>
</head>
<body>

<div class="topbar">
  <a class="domain" href="https://{{ basics.website }}">{{ basics.website }}</a>
  <nav aria-label="Site">
    <a href="#experience">Experience</a>
    <a href="#projects">Projects</a>
    <a class="btn" href="{{ pdf_name }}.pdf">Download résumé (PDF)</a>
  </nav>
</div>

<main>
  <header class="head">
    <div class="who">
      <img src="assets/headshot.jpg" alt="{{ basics.name }}" width="104" height="104">
      <div>
        <h1>{{ basics.name }}</h1>
        <div class="label">{{ basics.label }} · {{ basics.location }}</div>
      </div>
    </div>
    <nav class="contact" aria-label="Contact">
      <a href="mailto:{{ basics.email }}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        {{ basics.email }}</a>
      <a href="https://www.linkedin.com/in/{{ basics.linkedin }}/" target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v5M8 8v.01M12 16v-5M16 16v-3a2 2 0 0 0-4 0"/></svg>
        linkedin.com/in/{{ basics.linkedin }}</a>
      <a href="https://github.com/{{ basics.github }}" target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.5 6-6.6a5 5 0 0 0-1.4-3.6 4.7 4.7 0 0 0-.1-3.6s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.5 0C6 1.1 4.9 1.4 4.9 1.4a4.7 4.7 0 0 0-.1 3.6A5 5 0 0 0 3.4 8.5c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.3V21"/></svg>
        github.com/{{ basics.github }}</a>
    </nav>
  </header>

  <p class="summary">{{ basics.summary }}</p>

  <section id="experience" aria-labelledby="experience-h">
    <h2 class="bar" id="experience-h">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
      Experience</h2>
    {% for g in work_groups %}
    <article class="entry">
      {% if g.roles | length == 1 %}{% set job = g.roles[0] %}
      <div class="row"><span class="org">{{ job.org }}</span><span class="date">{{ job.start | date }} – {{ job.end | date }}</span></div>
      <div class="row sub"><span>{{ job.title }}</span><span>{{ job.location }}</span></div>
      {% if job.bullets %}<ul class="items">{% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
      {% else %}
      <div class="row"><span class="org">{{ g.org }}</span><span class="date">{{ g.location }}</span></div>
      {% for job in g.roles %}
      <div class="role">
        <div class="row sub"><span>{{ job.title }}</span><span class="date">{{ job.start | date }} – {{ job.end | date }}</span></div>
        {% if job.bullets %}<ul class="items">{% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
      </div>
      {% endfor %}
      {% endif %}
    </article>
    {% endfor %}
  </section>

  <section id="projects" aria-labelledby="projects-h">
    <h2 class="bar" id="projects-h">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2h12.4a1.5 1.5 0 0 0 1.3-2L14 9V3"/></svg>
      Projects</h2>
    <div class="projects">
      {% for p in projects %}
      <article class="project">
        <h3>{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener noreferrer">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</h3>
        {% if p.context %}<div class="context">{{ p.context }}</div>{% endif %}
        {% if p.bullets %}<ul class="items">{% for b in p.bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
        {% if p.tags %}<div class="tags">{{ p.tags | join(' · ') }}</div>{% endif %}
      </article>
      {% endfor %}
    </div>
  </section>

  <section aria-labelledby="skills-h">
    <h2 class="bar" id="skills-h">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1"/></svg>
      Technical Skills</h2>
    <div class="skills">
      {% for s in skills %}
      <div><b>{{ s.group }}</b>{{ s['items'] | join(', ') }}</div>
      {% endfor %}
      {% if certifications %}<div><b>Certifications</b>{{ certifications | join(', ') }}</div>{% endif %}
    </div>
  </section>

  <section aria-labelledby="education-h">
    <h2 class="bar" id="education-h">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg>
      Education</h2>
    {% for ed in education %}
    <div class="entry">
      <div class="row"><span><span class="org">{{ ed.school }}</span> <span class="sub">· {{ ed.degree }}</span></span><span class="date">{{ ed.start | date }} – {{ ed.end | date }}</span></div>
    </div>
    {% endfor %}
  </section>
</main>

<footer class="foot">
  <span>Last updated {{ build_date }}</span>
  <a class="btn" href="{{ pdf_name }}.pdf">Download résumé (PDF)</a>
</footer>

</body>
</html>
